# Service
SERVICE_NAME=cv-stream-timescale-api
SERVICE_VERSION=0.1.0

# Capture: http_mjpeg | rtsp | rtmp | camera | file
CAPTURE_SOURCE_KIND=http_mjpeg
CAPTURE_SOURCE_URL=http://PHONE_IP:8080/video
CAPTURE_USERNAME=
CAPTURE_PASSWORD=
CAPTURE_FPS_LIMIT=15
CAPTURE_DEVICE_ID=1
CAPTURE_TASK_ID=1

# Stream: pull | push
STREAM_MODE=pull
STREAM_PROTOCOL=http_mjpeg
STREAM_PUSH_URL=rtmp://SERVER_HOST:1935/live/mystream
STREAM_USERNAME=
STREAM_PASSWORD=

# Inference
# Empty INFERENCE_ENDPOINT means local inference.
# Remote inference uses a directly reachable API base URL, for example http://REMOTE_API_HOST:8000.
INFERENCE_ENDPOINT=
INFERENCE_DEVICE=auto
INFERENCE_MODEL=yolov8n.pt
CONFIDENCE_THRESHOLD=0.5
FRAME_INTERVAL=10

# Database
# Runtime database writes use PostgreSQL TCP directly. SSH is not required for DATABASE_URL.
DATABASE_URL=postgresql://cv_user:CHANGE_ME@DB_HOST:5432/cv_stream
DATABASE_CONNECT_TIMEOUT=5
DATABASE_BATCH_SIZE=50
DATABASE_FLUSH_INTERVAL_MS=1000

# Spool
SPOOL_SQLITE_PATH=runtime/spool.db

# Remote server
# REMOTE_API_BASE_URL is the directly reachable remote API URL shown in the dashboard.
# REMOTE_SSH_* is optional and only used for remote management scripts.
REMOTE_API_BASE_URL=
REMOTE_API_HOST=127.0.0.1
REMOTE_API_PORT=8000
REMOTE_SSH_HOST=
REMOTE_SSH_PORT=22
REMOTE_SSH_USER=
REMOTE_SSH_KEY_PATH=
