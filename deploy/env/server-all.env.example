# Server-side capture, local server inference, local server database.
# Use a video URL that the server can open.

CAPTURE_SOURCE_KIND=rtsp
API_AUTH_TOKEN=
CORS_ALLOWED_ORIGINS="http://SERVER_HOST:5173 http://127.0.0.1:5173 http://localhost:5173"
CAPTURE_SOURCE_URL=rtsp://STREAM_HOST:8554/camera
CAPTURE_USERNAME=
CAPTURE_PASSWORD=
CAPTURE_FPS_LIMIT=15
CAPTURE_ROTATE_DEGREES=0
CAPTURE_DEVICE_ID=1
CAPTURE_TASK_ID=1

STREAM_MODE=push
STREAM_PROTOCOL=rtsp
STREAM_PUSH_URL=rtmp://STREAM_HOST:1935/camera
STREAM_RECEIVER_KIND=mediamtx
STREAM_RECEIVER_STATUS_URL=http://127.0.0.1:9997/v3/config/global/get
STREAM_USERNAME=
STREAM_PASSWORD=

INFERENCE_ENDPOINT=
INFERENCE_API_TOKEN=
INFERENCE_DEVICE=auto
INFERENCE_MODEL=yolov8n.pt
CONFIDENCE_THRESHOLD=0.5
FRAME_INTERVAL=10
DETECTION_CLASS_FILTER=
ANALYSIS_TIME_RANGE_MINUTES=30

DATABASE_URL=postgresql://cv_user:CHANGE_ME@127.0.0.1:5432/cv_stream
DATABASE_CONNECT_TIMEOUT=5
DATABASE_BATCH_SIZE=50
DATABASE_FLUSH_INTERVAL_MS=1000
SPOOL_SQLITE_PATH=runtime/spool.db

REMOTE_API_BASE_URL=http://SERVER_HOST:8000
REMOTE_API_HOST=0.0.0.0
REMOTE_API_PORT=8000
REMOTE_SSH_HOST=
REMOTE_SSH_PORT=22
REMOTE_SSH_USER=
REMOTE_SSH_KEY_PATH=

GRAFANA_BASE_URL=http://SERVER_HOST:3000
GRAFANA_DASHBOARD_URL=http://SERVER_HOST:3000/d/cv-stream/cv-stream
