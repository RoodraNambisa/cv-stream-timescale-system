# Local capture, local inference, local database.
# Copy selected keys into .env and adjust hosts, secrets, and video source.

CAPTURE_SOURCE_KIND=http_mjpeg
API_AUTH_TOKEN=
CORS_ALLOWED_ORIGINS="http://127.0.0.1:5173 http://localhost:5173"
CAPTURE_SOURCE_URL=http://PHONE_IP:8080/video
CAPTURE_USERNAME=
CAPTURE_PASSWORD=
CAPTURE_FPS_LIMIT=15
CAPTURE_ROTATE_DEGREES=0
CAPTURE_DEVICE_ID=1
CAPTURE_TASK_ID=1

STREAM_MODE=pull
STREAM_PROTOCOL=http_mjpeg
STREAM_PUSH_URL=
STREAM_RECEIVER_KIND=none
STREAM_RECEIVER_STATUS_URL=
STREAM_USERNAME=
STREAM_PASSWORD=

INFERENCE_ENDPOINT=
INFERENCE_API_TOKEN=
INFERENCE_DEVICE=auto
INFERENCE_MODEL=yolov8n.pt
CONFIDENCE_THRESHOLD=0.5
FRAME_INTERVAL=10
DETECTION_CLASS_FILTER=
ANALYSIS_TIME_RANGE_MINUTES=30

DATABASE_URL=postgresql://cv_user:CHANGE_ME@127.0.0.1:5432/cv_stream
DATABASE_CONNECT_TIMEOUT=5
DATABASE_BATCH_SIZE=50
DATABASE_FLUSH_INTERVAL_MS=1000
SPOOL_SQLITE_PATH=runtime/spool.db

REMOTE_API_BASE_URL=
REMOTE_API_HOST=127.0.0.1
REMOTE_API_PORT=8000
REMOTE_SSH_HOST=
REMOTE_SSH_PORT=22
REMOTE_SSH_USER=
REMOTE_SSH_KEY_PATH=

GRAFANA_BASE_URL=
GRAFANA_DASHBOARD_URL=
